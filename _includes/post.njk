---
layout: base.njk
---
<article class="wrap post">
  <a class="back" href="/news/">← All news</a>
  <div class="post-date">{{ page.date | longDate }}</div>
  <h1>{{ title }}</h1>
  <div class="prose">{{ content | safe }}</div>
  {% if images and images.length %}
  <div class="gallery gallery-{{ images.length if images.length < 4 else 'many' }}">
    {% for name in images %}{% set small = ('news/' + name) | img(1000) %}{% if small %}
    <a href="{{ ('news/' + name) | img(2000) }}" data-zoom><img src="{{ small }}" alt="{{ title }}, photo {{ loop.index }}" loading="lazy"></a>
    {% endif %}{% endfor %}
  </div>
  {% endif %}
  {% set all = collections.news %}
  {% for item in all %}{% if item.url == page.url %}
  <nav class="post-nav" aria-label="More news">
    {% set newer = all[loop.index0 - 1] if loop.index0 > 0 else none %}
    {% set older = all[loop.index0 + 1] %}
    <div>{% if older %}<a href="{{ older.url }}"><span>← Older</span>{{ older.data.title }}</a>{% endif %}</div>
    <div class="right">{% if newer %}<a href="{{ newer.url }}"><span>Newer →</span>{{ newer.data.title }}</a>{% endif %}</div>
  </nav>
  {% endif %}{% endfor %}
</article>
